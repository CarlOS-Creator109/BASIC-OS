10 REM PONG DE TEXTO PARA PC BASIC
20 REM W/S = MOVER LA PALETA   ESC = SALIR
30 COLOR 1,6:S=0:T=0
40 GOSUB 500
100 P=10:Q=10:X=24:Y=11:U=1:V=1
105 Z$="#":C=5:R=P:GOSUB 700:C=44:R=Q:GOSUB 700
110 K$=INKEY$
120 IF K$="W" OR K$="w" THEN GOSUB 800
130 IF K$="S" OR K$="s" THEN GOSUB 810
140 GOSUB 900
145 IF S>=7 OR T>=7 THEN GOTO 1400
150 SLEEP 70
160 GOTO 110
500 CLS
510 LOCATE 4,0:PRINT "PONG  -  W/S = MOVER  -  ESC = SALIR"
520 LOCATE 4,2:PRINT "==========================================";
530 LOCATE 4,21:PRINT "==========================================";
540 GOSUB 600
550 RETURN
600 LOCATE 14,23:PRINT "TU:";S;"  PC:";T;"  ";
610 RETURN
700 FOR I=0 TO 3:LOCATE C,R+I:PRINT Z$;:NEXT I
710 RETURN
800 Z$=" ":C=5:R=P:GOSUB 700
802 IF P>3 THEN P=P-1
804 Z$="#":R=P:GOSUB 700
806 RETURN
810 Z$=" ":C=5:R=P:GOSUB 700
812 IF P<17 THEN P=P+1
814 Z$="#":R=P:GOSUB 700
816 RETURN
820 Z$=" ":C=44:R=Q:GOSUB 700
822 IF Q<17 THEN Q=Q+1
824 Z$="#":R=Q:GOSUB 700
826 RETURN
830 Z$=" ":C=44:R=Q:GOSUB 700
832 IF Q>3 THEN Q=Q-1
834 Z$="#":R=Q:GOSUB 700
836 RETURN
900 LOCATE X,Y:PRINT " ";
902 X=X+U:Y=Y+V
910 IF X<25 THEN GOTO 920
912 IF Y>Q+1 THEN GOSUB 820
914 IF Y<Q+1 THEN GOSUB 830
920 IF Y<=3 THEN GOSUB 1000
922 IF Y>=20 THEN GOSUB 1010
924 IF X=6 THEN GOSUB 1100
926 IF X=43 THEN GOSUB 1200
928 LOCATE X,Y:PRINT "O";
929 RETURN
1000 V=1:SOUND TRIANGLE,330,40
1005 RETURN
1010 V=-1:SOUND TRIANGLE,330,40
1015 RETURN
1100 IF Y>=P AND Y<=P+3 THEN GOTO 1110
1102 T=T+1:GOSUB 1300
1104 RETURN
1110 U=1:SOUND SQUARE,880,50
1115 RETURN
1200 IF Y>=Q AND Y<=Q+3 THEN GOTO 1210
1202 S=S+1:GOSUB 1300
1204 RETURN
1210 U=-1:SOUND SQUARE,660,50
1215 RETURN
1300 LOCATE X,Y:PRINT " ";
1310 X=24:Y=11:U=-U
1320 SOUND KICK,55,250
1330 GOSUB 600
1340 SLEEP 500
1350 RETURN
1400 LOCATE 12,11
1410 IF S>=7 THEN PRINT "GANASTE!  -  OTRA PARTIDA EN 3 SEGUNDOS";
1420 IF T>=7 THEN PRINT "PERDISTE  -  OTRA PARTIDA EN 3 SEGUNDOS";
1430 SOUND DRUMKIT,60,0,2500
1440 SLEEP 3000
1450 S=0:T=0
1460 GOSUB 500
1470 GOTO 100
