diff --git a/src/net/tcp/httpcore.c b/src/net/tcp/httpcore.c
index 80d91b78f..901fce716 100644
--- a/src/net/tcp/httpcore.c
+++ b/src/net/tcp/httpcore.c
@@ -2023,6 +2023,10 @@ static size_t http_form_params ( struct parameters *params, char *buf,
  * @v uri		Request URI
  * @ret rc		Return status code
  */
+/* BASICOS: lo pone bospost (interface/basicos/basicos.c) mientras dura la peticion */
+const void *bos_post_data;
+size_t bos_post_len;
+
 int http_open_uri ( struct interface *xfer, struct uri *uri ) {
 	struct parameters *params = uri->params;
 	struct http_request_content content;
@@ -2079,6 +2083,14 @@ int http_open_uri ( struct interface *xfer, struct uri *uri ) {
 	content.data = data;
 	content.len = len;
 
+	/* BASICOS: "bospost" sube un bloque de memoria como cuerpo de un POST */
+	if ( bos_post_data ) {
+		method = &http_post;
+		content.type = "application/octet-stream";
+		content.data = bos_post_data;
+		content.len = bos_post_len;
+	}
+
 	/* Open HTTP transaction */
 	if ( ( rc = http_open ( xfer, method, uri, NULL, &content ) ) != 0 )
 		goto err_open;
