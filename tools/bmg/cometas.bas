1 REM ICONO "COMETAS"
2 REM ICB ................
3 REM ICB .....CCCC.......
4 REM ICB ...CCFFFFCC.....
5 REM ICB ..CFFCFFFFFC....
6 REM ICB ..CFFFFFCFFC....
7 REM ICB .CFFCFFFFFFFC...
8 REM ICB .CFFFFFCCFFFC.7.
9 REM ICB ..CFFFFFFFFC..7.
10 REM ICB ...CCFFFFCC...7.
