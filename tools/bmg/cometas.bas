20 REM COMETAS - JUEGO DE EJEMPLO DEL MOTOR BMG (BASIC-OS MOTOR GAME)
21 REM FLECHAS: MOVER   ESPACIO: DISPARAR   ESC: SALIR
22 REM SPRITES: 0 NAVE, 1 DISPARO, 2-4 COMETAS
30 COLOR 1,0:CLS
40 W=XMAX:Z=YMAX
50 FOR N=1 TO 150:PLOT RND(W),RND(Z-20)+18,RND(2)*14+1:NEXT N
60 GOSUB 1000
70 X=W/2-16:Y=Z-28:C=-1:S=0:L=3:V=3
80 LOCATE W/16-6,Z/32:PRINT "C O M E T A S"
82 LOCATE W/16-12,Z/32+2:PRINT "FLECHAS Y ESPACIO PARA JUGAR"
84 SPRITE 0,X,Y
86 FRAME:IF NOT KEYDOWN(32) THEN 86
88 LOCATE W/16-12,Z/32:PRINT "                             "
89 LOCATE W/16-12,Z/32+2:PRINT "                             "
90 GOSUB 700:GOSUB 710:GOSUB 720:GOSUB 800
100 REM ---- BUCLE DEL JUEGO: 30 CUADROS POR SEGUNDO ----
110 IF KEYDOWN(157) AND X>5 THEN X=X-6
120 IF KEYDOWN(29) AND X<W-37 THEN X=X+6
130 IF KEYDOWN(32) AND C<0 THEN B=X+14:C=Y-12:BEEP 3,1600
140 IF C>=0 THEN C=C-12
145 IF C>=0 AND C<18 THEN C=-1:SPRITE OFF 1
150 IF C>=0 THEN SPRITE 1,B,C
160 SPRITE 0,X,Y
170 F=F+V:H=H+V:J=J+V+1
180 IF F>18 THEN SPRITE 2,E,F
190 IF H>18 THEN SPRITE 3,G,H
200 IF J>18 THEN SPRITE 4,I,J
210 IF F>Z THEN GOSUB 700
220 IF H>Z THEN GOSUB 710
230 IF J>Z THEN GOSUB 720
240 IF HIT(1,2) THEN T=2:GOSUB 600
250 IF HIT(1,3) THEN T=3:GOSUB 600
260 IF HIT(1,4) THEN T=4:GOSUB 600
270 IF HIT(0,2) OR HIT(0,3) OR HIT(0,4) THEN GOSUB 650
280 FRAME 30
290 IF L>0 THEN 110
300 REM ---- FIN ----
310 SPRITE OFF:FRAME
320 LOCATE W/16-8,Z/32:PRINT "FIN DEL JUEGO"
330 LOCATE W/16-8,Z/32+2:PRINT "PUNTOS:";S
340 LOCATE W/16-14,Z/32+4:PRINT "ENTER = OTRA VEZ   ESC = SALIR"
350 K$=INKEY$:IF K$<>"" THEN 350
360 SLEEP 20:K$=INKEY$:IF K$=CHR$(13) THEN RUN
370 GOTO 360
600 REM ---- UN DISPARO DIO EN EL COMETA T ----
610 S=S+10:C=-1:SPRITE OFF 1:BEEP 12,300
620 IF S/100*100=S THEN V=V+1
630 IF T=2 THEN GOSUB 700
640 IF T=3 THEN GOSUB 710
645 IF T=4 THEN GOSUB 720
648 GOSUB 800:RETURN
650 REM ---- UN COMETA CHOCO CON LA NAVE ----
660 L=L-1:BEEP 150,120
670 GOSUB 700:GOSUB 710:GOSUB 720:GOSUB 800:RETURN
700 E=RND(W-28)+2:F=-RND(90):SPRITE OFF 2:RETURN
710 G=RND(W-28)+2:H=-RND(90)-40:SPRITE OFF 3:RETURN
720 I=RND(W-28)+2:J=-RND(90)-80:SPRITE OFF 4:RETURN
800 LOCATE 0,0:PRINT "COMETAS  PUNTOS:";S;"  VIDAS:";L;"  NIVEL:";V-2;"   ":RETURN
1000 REM ---- DIBUJOS (UN DIGITO HEX = COLOR DEL C64, PUNTO = NADA; EL ,2 = ZOOM X2) ----
1010 SPRITE DEF 0,16,12,2
1020 SPRITE ROW 0,0,".......11......."
1030 SPRITE ROW 0,1,"......1331......"
1040 SPRITE ROW 0,2,"......1331......"
1050 SPRITE ROW 0,3,".....133331....."
1060 SPRITE ROW 0,4,"....13377331...."
1070 SPRITE ROW 0,5,"...1333773331..."
1080 SPRITE ROW 0,6,"..133333333331.."
1090 SPRITE ROW 0,7,".13333333333331."
1100 SPRITE ROW 0,8,"1333311111133331"
1110 SPRITE ROW 0,9,"1111........1111"
1120 SPRITE ROW 0,10,".22..........22."
1130 SPRITE ROW 0,11,"..2..........2.."
1140 SPRITE DEF 1,2,6,2
1150 FOR N=0 TO 5:SPRITE ROW 1,N,"77":NEXT N
1160 SPRITE DEF 2,12,12,2
1170 SPRITE ROW 2,0,"....CCCC...."
1180 SPRITE ROW 2,1,"..CCFFFFCC.."
1190 SPRITE ROW 2,2,".CFFCFFFFFC."
1200 SPRITE ROW 2,3,".CFFFFFCFFC."
1210 SPRITE ROW 2,4,"CFFCFFFFFFFC"
1220 SPRITE ROW 2,5,"CFFFFFCCFFFC"
1230 SPRITE ROW 2,6,"CFFFFFCCFFFC"
1240 SPRITE ROW 2,7,"CFFCFFFFFCFC"
1250 SPRITE ROW 2,8,".CFFFFFFFFC."
1260 SPRITE ROW 2,9,".CFFCFFFFCC."
1270 SPRITE ROW 2,10,"..CCFFFFCC.."
1280 SPRITE ROW 2,11,"....CCCC...."
1290 SPRITE COPY 3,2:SPRITE COPY 4,2
1300 RETURN
